rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // These lookups are cross-service Rules. They only work once the Cloud
    // Storage service agent has been granted
    // roles/firebaserules.firestoreServiceAgent; without it every call returns
    // null and every rule below denies. Deploying interactively prompts for
    // the grant, so never deploy this file with --non-interactive.
    function isMember(householdId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/households/$(householdId))
        && request.auth.uid in firestore.get(/databases/(default)/documents/households/$(householdId)).data.members;
    }

    function isOwnerOfHousehold(householdId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/households/$(householdId))
        && request.auth.uid == firestore.get(/databases/(default)/documents/households/$(householdId)).data.ownerId;
    }

    // Proof photos are evidence, so a name may be claimed once and never
    // replaced: `resource == null` allows the first upload and rejects any
    // write over an existing file.
    match /households/{householdId}/proofs/{fileName} {
      allow read: if isMember(householdId);
      allow write: if isMember(householdId)
        && resource == null
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg');
    }

    // Custom profile-photo uploads. A member may set their own avatar; the
    // household owner may set an avatar for local (non-Google) residents too.
    // The client stores an avatar as <userId>.jpg, and the wildcard binds the
    // whole file name, extension included, so the comparison has to spell it
    // out. Matching on the bare uid silently locked every non-owner member out
    // of their own avatar.
    match /households/{householdId}/avatars/{fileName} {
      allow read: if isMember(householdId);
      allow write: if isMember(householdId)
        && (fileName == request.auth.uid + '.jpg' || isOwnerOfHousehold(householdId))
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg');
    }
  }
}
