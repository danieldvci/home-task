{
  "entities": {
    "Household": {
      "title": "Household",
      "description": "A group of users sharing chores",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128 },
        "members": { "type": "array", "maxLength": 20 }
      },
      "required": ["ownerId", "members"]
    },
    "User": {
      "title": "User",
      "description": "Household profile — Google-linked or local guest",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "color": { "type": "string", "maxLength": 50 },
        "isAbsent": { "type": "boolean", "description": "Mirror of 'absent right now'; the window below is authoritative" },
        "absentFrom": { "type": "string", "maxLength": 40, "description": "ISO datetime the absence starts" },
        "absentUntil": { "type": "string", "maxLength": 40, "description": "ISO datetime the absence ends; null means open-ended" },
        "linkedAuth": { "type": "boolean" },
        "photoURL": { "type": "string", "maxLength": 2000 }
      },
      "required": ["name", "color", "isAbsent", "linkedAuth"]
    },
    "Chore": {
      "title": "Chore",
      "description": "A chore to be completed",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "frequency": { "type": "string", "enum": ["daily", "weekly", "custom_days", "once"] },
        "onceDate": { "type": "string", "maxLength": 40, "description": "The single day a 'once' task occurs on; required for that frequency" },
        "customDays": { "type": "array", "maxLength": 7 },
        "category": { "type": "string", "maxLength": 40 },
        "rotation": { "type": "array", "maxLength": 20 },
        "currentIndex": { "type": "number" },
        "lastCompletedAt": { "type": "string", "maxLength": 40, "description": "Newest completed day; denormalised from completions" },
        "lastCompletedLogId": { "type": "string", "maxLength": 128 },
        "completions": {
          "type": "object",
          "maxLength": 400,
          "description": "YYYY-MM-DD -> { userId, logId, at, skipped? }; freezes each resolved occurrence to the resident who did it, or who was skipped"
        },
        "anchorDate": { "type": "string", "maxLength": 40, "description": "Day a weekly schedule repeats from, fixed at creation" }
      },
      "required": ["name", "frequency", "rotation", "currentIndex"]
    },
    "Log": {
      "title": "Log",
      "description": "Activity log entry",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "description": "Resident profile the entry is attributed to" },
        "actorUid": { "type": "string", "maxLength": 128, "description": "Signed-in account that wrote the entry; required on write, absent on records predating the binding" },
        "action": { "type": "string", "maxLength": 100 },
        "details": { "type": "string", "maxLength": 200 },
        "timestamp": { "type": "string", "maxLength": 40 },
        "photoUrl": { "type": "string", "maxLength": 2000, "description": "First entry of photoUrls, kept for records written before multi-photo" },
        "photoUrls": { "type": "array", "maxLength": 3, "description": "Proof photos in pick order" },
        "choreId": { "type": "string", "maxLength": 128, "description": "Chore this record refers to, when one was linked" },
        "reactions": { "type": "object", "description": "authUid -> like | love | laugh | wow | dislike" },
        "comments": { "type": "array", "maxLength": 30, "description": "{ userId, actorUid, text, timestamp }; actorUid is the signed-in account, required on write" }
      },
      "required": ["userId", "actorUid", "action", "details", "timestamp"]
    }
  },
  "firestore": {
    "/households/{householdId}": {
      "schema": { "$ref": "#/entities/Household" },
      "description": "Stores household metadata and members."
    },
    "/households/{householdId}/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Users inside a household."
    },
    "/households/{householdId}/chores/{choreId}": {
      "schema": { "$ref": "#/entities/Chore" },
      "description": "Chores inside a household."
    },
    "/households/{householdId}/logs/{logId}": {
      "schema": { "$ref": "#/entities/Log" },
      "description": "Activity logs inside a household."
    }
  }
}
