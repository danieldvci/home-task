rules_version = '2';

// Scope note: these rules enforce membership, document shape, and the identity
// of whoever writes a log or comment. Whose turn it is to do a chore is
// deliberately NOT enforced here. Rotation is projected from a completions map
// and an absence window, which rules cannot compute, so any member can move the
// queue through the SDK. This is a known and accepted trade-off for a household
// app, not an oversight; see ROADMAP.md.
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function householdPath(householdId) {
      return /databases/$(database)/documents/households/$(householdId);
    }
    function householdData(householdId) {
      return get(householdPath(householdId)).data;
    }
    // exists() before the field read: get() of a household that is not on the
    // server yet is null, and reading .members off that is an evaluation
    // error rather than a denial. The same path is one document read.
    function isMember(householdId) {
      return isSignedIn()
        && exists(householdPath(householdId))
        && request.auth.uid in householdData(householdId).members;
    }
    function isOwner(householdId) {
      return isSignedIn()
        && exists(householdPath(householdId))
        && request.auth.uid == householdData(householdId).ownerId;
    }

    // The owner, or an account the owner promoted. Read with a default because
    // every household written before co-managers existed has no such field,
    // and reading a missing key is an error rather than an empty list.
    // Membership is asked again rather than assumed: a disconnected member is
    // dropped from `members` in one write and from `managerIds` in another,
    // and between the two the role must already count for nothing.
    function isManager(householdId) {
      return isOwner(householdId)
        || (isMember(householdId) && request.auth.uid in householdData(householdId).get('managerIds', []));
    }

    // Managers are a subset of the accounts that can reach the household at
    // all, so a promotion cannot smuggle in somebody who is not a member.
    function isValidManagerIds(data) {
      let ids = data.get('managerIds', []);
      return ids is list
        && ids.size() <= 20
        && data.members.hasAll(ids);
    }

    function isValidHousehold(data) {
      let hasName = data.keys().hasAny(['name']);
      let hasSetup = data.keys().hasAny(['setupComplete']);
      return data.keys().hasAll(['ownerId', 'members'])
        && data.keys().hasOnly(['ownerId', 'members', 'name', 'managerIds', 'setupComplete'])
        && data.ownerId is string && data.ownerId.size() <= 128
        && data.members is list && data.members.size() > 0 && data.members.size() <= 20
        && data.members[0] is string
        && isValidManagerIds(data)
        && (!hasSetup || data.setupComplete is bool)
        && (!hasName || (data.name is string && data.name.size() > 0 && data.name.size() <= 80));
    }

    // absentFrom/absentUntil describe the absence window as ISO datetimes;
    // isAbsent is the "absent right now" mirror kept for older clients.
    function isValidUser(data) {
      let hasFrom = data.keys().hasAny(['absentFrom']);
      let hasUntil = data.keys().hasAny(['absentUntil']);

      return data.keys().hasAll(['name', 'color', 'isAbsent', 'linkedAuth'])
        && data.keys().hasOnly(['name', 'color', 'isAbsent', 'linkedAuth', 'photoURL', 'absentFrom', 'absentUntil', 'icon'])
        && data.name is string && data.name.size() <= 100
        && data.color is string && data.color.size() <= 50
        && data.isAbsent is bool
        && data.linkedAuth is bool
        // The name of an icon, never an image: a photo is photoURL and wins
        // over this wherever a resident is drawn.
        && (!data.keys().hasAny(['icon']) || (data.icon is string && data.icon.size() <= 24))
        && (!hasFrom || data.absentFrom == null || (data.absentFrom is string && data.absentFrom.size() <= 40))
        && (!hasUntil || data.absentUntil == null || (data.absentUntil is string && data.absentUntil.size() <= 40))
        && (!data.keys().hasAny(['photoURL']) || (data.photoURL is string && data.photoURL.size() <= 2000));
    }

    function isValidChoreStrict(data) {
      let hasCustom = data.keys().hasAny(['customDays']);
      let hasLastComp = data.keys().hasAny(['lastCompletedAt']);
      let hasCategory = data.keys().hasAny(['category']);
      let hasLastLog = data.keys().hasAny(['lastCompletedLogId']);
      // Per-day completion records: { 'YYYY-MM-DD': { userId, logId, at } }.
      // Rules cannot iterate map values, so only the shape of the map itself is
      // checked here; entry contents are written by the client.
      let hasCompletions = data.keys().hasAny(['completions']);
      // Day a weekly schedule repeats from; fixed when the chore is created.
      let hasAnchor = data.keys().hasAny(['anchorDate']);
      // The single day a 'once' task occurs on.
      let hasOnceDate = data.keys().hasAny(['onceDate']);
      // First day the chore exists; days before it are not occurrences.
      let hasStartDate = data.keys().hasAny(['startDate']);
      // Name of the icon the chore is drawn with, from a fixed list the client
      // owns. A chore without one is drawn from its name instead.
      let hasIcon = data.keys().hasAny(['icon']);
      let baseSize = 4;
      let totalSize = baseSize + (hasCustom ? 1 : 0) + (hasLastComp ? 1 : 0) + (hasCategory ? 1 : 0)
        + (hasLastLog ? 1 : 0) + (hasCompletions ? 1 : 0) + (hasAnchor ? 1 : 0) + (hasOnceDate ? 1 : 0)
        + (hasStartDate ? 1 : 0) + (hasIcon ? 1 : 0);

      return data.keys().hasAll(['name', 'frequency', 'rotation', 'currentIndex'])
        && data.keys().size() == totalSize
        && data.name is string && data.name.size() <= 100
        && data.frequency is string && data.frequency in ['daily', 'weekly', 'custom_days', 'once']
        && data.rotation is list && data.rotation.size() <= 20
        && data.currentIndex is number
        && (!hasCustom || (data.customDays is list && data.customDays.size() <= 7))
        && (!hasLastComp || (data.lastCompletedAt == null || (data.lastCompletedAt is string && data.lastCompletedAt.size() <= 40)))
        && (!hasCategory || (data.category is string && data.category.size() <= 40))
        && (!hasLastLog || (data.lastCompletedLogId == null || (data.lastCompletedLogId is string && data.lastCompletedLogId.size() <= 128)))
        && (!hasCompletions || (data.completions is map && data.completions.size() <= 400))
        && (!hasAnchor || (data.anchorDate == null || (data.anchorDate is string && data.anchorDate.size() <= 40)))
        && (!hasOnceDate || (data.onceDate == null || (data.onceDate is string && data.onceDate.size() <= 40)))
        && (!hasStartDate || (data.startDate == null || (data.startDate is string && data.startDate.size() <= 40)))
        && (!hasIcon || (data.icon == null || (data.icon is string && data.icon.size() <= 24)))
        && (data.frequency != 'once' || (hasOnceDate && data.onceDate is string));
    }

    // userId is the resident profile the entry is shown as, which is picked
    // freely on a shared device. actorUid is the account that actually wrote it
    // and is pinned to the caller, so authorship cannot be faked. Records
    // written before actorUid existed keep working: it is required on write
    // only, and log updates never re-validate the whole document.
    function isValidLog(data) {
      return data.keys().hasAll(['userId', 'actorUid', 'action', 'details', 'timestamp'])
        && data.keys().hasOnly(['userId', 'actorUid', 'action', 'details', 'timestamp', 'photoUrl', 'photoUrls', 'choreId', 'reactions', 'comments'])
        && data.actorUid == request.auth.uid
        && data.userId is string && data.userId.size() <= 128
        && data.action is string && data.action.size() <= 100
        && data.details is string && data.details.size() <= 200
        && data.timestamp is string && data.timestamp.size() <= 40
        && (!data.keys().hasAny(['photoUrl']) || (data.photoUrl is string && data.photoUrl.size() <= 2000))
        && (!data.keys().hasAny(['photoUrls']) || (data.photoUrls is list && data.photoUrls.size() <= 3))
        && (!data.keys().hasAny(['choreId']) || (data.choreId is string && data.choreId.size() <= 128));
    }

    // A member may only set or clear the reaction stored under their own uid,
    // and only to one of the emotions the client offers.
    function isReactionUpdate() {
      let before = existing().get('reactions', {});
      let after = incoming().reactions;
      return after is map
        && after.keys().size() <= 20
        && after.diff(before).affectedKeys().hasOnly([request.auth.uid])
        && (
          !after.keys().hasAny([request.auth.uid])
          || after[request.auth.uid] in ['like', 'love', 'laugh', 'wow', 'dislike']
        );
    }

    // Only the appended comment is validated, so older comments without
    // actorUid survive untouched.
    function isValidComment(c) {
      return c is map
        && c.keys().hasOnly(['userId', 'actorUid', 'text', 'timestamp'])
        && c.keys().hasAll(['userId', 'actorUid', 'text', 'timestamp'])
        && c.actorUid == request.auth.uid
        && c.userId is string && c.userId.size() <= 128
        && c.text is string && c.text.size() > 0 && c.text.size() <= 200
        && c.timestamp is string && c.timestamp.size() <= 40;
    }

    // Members append exactly one comment at a time and keep existing ones.
    function isCommentAppend() {
      let before = existing().get('comments', []);
      let after = incoming().comments;
      let added = after is list ? after.removeAll(before) : [];
      return after is list
        && after.size() == before.size() + 1
        && after.size() <= 30
        && after.hasAll(before)
        && added.size() == 1
        && isValidComment(added[0]);
    }

    function isValidMembersList(m) {
      return m is list && m.size() > 0 && m.size() <= 20 && m[0] is string;
    }

    // Non-member adds only themselves (+1).
    function isMembersJoin() {
      return incoming().members.hasAll(existing().members)
        && incoming().members.size() == existing().members.size() + 1
        && request.auth.uid in incoming().members
        && !(request.auth.uid in existing().members);
    }

    // Exactly one uid dropped from members.
    function isSingleMemberRemoval() {
      return existing().members.size() == incoming().members.size() + 1
        && existing().members.hasAll(incoming().members);
    }

    // Owner removes another member (owner must remain in members).
    function isOwnerRemovingOther(hid) {
      return isOwner(hid)
        && isSingleMemberRemoval()
        && request.auth.uid in incoming().members;
    }

    // Any current member may remove only themselves.
    function isSelfLeave() {
      return isSingleMemberRemoval()
        && request.auth.uid in existing().members
        && !(request.auth.uid in incoming().members);
    }

    match /households/{householdId} {
      allow get: if isSignedIn() && isValidId(householdId);
      allow list: if isSignedIn() && request.auth.uid in resource.data.members;

      allow create: if isSignedIn()
        && isValidId(householdId)
        && isValidHousehold(incoming())
        && incoming().ownerId == request.auth.uid
        && request.auth.uid in incoming().members;

      // Join (+1 self), owner disconnects other, or self-leave; rename and the
      // manager list are the owner's; finishing setup is any manager's.
      allow update: if isSignedIn()
        && isValidId(householdId)
        && incoming().ownerId == existing().ownerId
        && (
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['members'])
            && isValidMembersList(incoming().members)
            && (isMembersJoin() || isOwnerRemovingOther(householdId) || isSelfLeave())
          )
          || (
            isOwner(householdId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'setupComplete'])
            && (
              !incoming().diff(existing()).affectedKeys().hasAny(['name'])
              || (incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 80)
            )
            && (!incoming().keys().hasAny(['setupComplete']) || incoming().setupComplete is bool)
            && incoming().members == existing().members
          )
          || (
            // A co-manager may finish the first run, which is the one household
            // field the everyday admin role needs. Not the name, not the roster.
            isManager(householdId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['setupComplete'])
            && incoming().setupComplete is bool
            && incoming().members == existing().members
          )
          || (
            // Handing out the role is the owner's alone, or a co-manager could
            // promote themselves out of every limit the role still has.
            isOwner(householdId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['managerIds'])
            && isValidManagerIds(incoming())
            && incoming().members == existing().members
          )
        );

      allow delete: if isOwner(householdId) && isValidId(householdId);

      match /users/{userId} {
        // list must not validate userId: on a collection query the document
        // wildcard is unbound, so isValidId would reject every query.
        allow get: if isMember(householdId) && isValidId(householdId) && isValidId(userId);
        allow list: if isMember(householdId) && isValidId(householdId);

        allow create: if isMember(householdId)
          && isValidId(householdId)
          && isValidId(userId)
          && isValidUser(incoming())
          && (
            isManager(householdId)
            || (userId == request.auth.uid && incoming().linkedAuth == true)
          );

        allow update: if isMember(householdId)
          && isValidId(householdId)
          && isValidId(userId)
          && isValidUser(incoming())
          && (
            isManager(householdId)
            || (userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['isAbsent', 'absentFrom', 'absentUntil', 'name', 'photoURL', 'color', 'linkedAuth', 'icon']))
          );

        allow delete: if isManager(householdId) && isValidId(householdId) && isValidId(userId);
      }

      match /chores/{choreId} {
        allow get: if isMember(householdId) && isValidId(householdId) && isValidId(choreId);
        allow list: if isMember(householdId) && isValidId(householdId);

        allow create: if isManager(householdId)
          && isValidId(householdId)
          && isValidId(choreId)
          && isValidChoreStrict(incoming());

        // A member who manages nothing may only mark done/undo (turn pointer +
        // completion fields). Skip/swap (rotation) is a manager's.
        allow update: if isMember(householdId)
          && isValidId(householdId)
          && isValidId(choreId)
          && isValidChoreStrict(incoming())
          && (
            isManager(householdId)
            || incoming().diff(existing()).affectedKeys()
                 .hasOnly(['currentIndex', 'lastCompletedAt', 'lastCompletedLogId', 'completions'])
          );

        allow delete: if isManager(householdId) && isValidId(householdId) && isValidId(choreId);
      }

      match /logs/{logId} {
        allow get: if isMember(householdId) && isValidId(householdId) && isValidId(logId);
        allow list: if isMember(householdId) && isValidId(householdId);
        allow create: if isMember(householdId)
          && isValidId(householdId)
          && isValidId(logId)
          && isValidLog(incoming());
        // Reactions and comments are the only mutable parts of a log entry;
        // a manager may additionally prune them for moderation.
        allow update: if isMember(householdId)
          && isValidId(householdId)
          && isValidId(logId)
          && (
            (incoming().diff(existing()).affectedKeys().hasOnly(['reactions']) && isReactionUpdate())
            || (incoming().diff(existing()).affectedKeys().hasOnly(['comments']) && isCommentAppend())
            || (
              isManager(householdId)
              && incoming().diff(existing()).affectedKeys().hasOnly(['reactions', 'comments'])
            )
          );
        allow delete: if isManager(householdId) && isValidId(householdId) && isValidId(logId);
      }
    }
  }
}
